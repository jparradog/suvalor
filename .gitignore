# =============================================================================
# Datos del usuario en runtime — NUNCA commitear
# =============================================================================
# El script genera todo esto bajo SUVALOR_HOME (o cwd). Si por error alguien
# corre `suvalor` desde el repo, estas reglas evitan que su data se filtre.

# Estado interno del paquete
_state/
_chrome_profile/
_Fallidos/
_PorClasificar/
_LOG.md

# Carpetas de salida (documentos contables por anio: 1900s-2099)
[12][0-9][0-9][0-9]/

# Carpetas de salida (subcomandos extractos / cartera)
Extractos/
Cartera/

# Documentos descargados sueltos (por si caen en raiz)
*.pdf
*.xls
*.xlsx
*.csv
VerDocumentoElectronico*
extracto-*
Portafolio*

# Descargas parciales / temporales (Chrome, navegadores, fallos a mitad)
*.crdownload
*.tmp
*.partial
*.download
# UUIDs hex sueltos (algunos sitios dejan archivos sin extension nombrados como UUID)
[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]

# Configuracion runtime del usuario
config.toml
.env
.env.*
!.env.example

